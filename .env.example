APP_ENV=development
AUTH_SESSION_DAYS=30
# Set this to the exact public origin (scheme, hostname, and optional port) in production.
PUBLIC_ORIGIN=
OPENROUTER_API_KEY=
# Optional; defaults to openrouter/free.
OPENROUTER_MODEL=openrouter/free
# Optional; defaults to sqlite:///./data/vdss.db.
DATABASE_URL=sqlite:///./data/vdss.db